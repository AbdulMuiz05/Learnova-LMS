# Base URL of the Express API, including the /api prefix.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Optional. Socket.IO origin. Defaults to NEXT_PUBLIC_API_URL without /api.
# Leave unset when the API is deployed to Vercel Functions.
# NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Set to false when the API runs on Vercel (serverless functions cannot host
# persistent Socket.IO connections). Notifications are still persisted and
# loaded through the API on page load.
# NEXT_PUBLIC_REALTIME_ENABLED=false
