# ---------------------------------------------------------------------------
# Learnova — server environment
# Copy this file to server/.env (or the repository root as .env) and fill in
# production values. Never commit a real .env file.
# ---------------------------------------------------------------------------

# Core
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/learnova_lms
CLIENT_URL=http://localhost:3000
APP_NAME=Learnova

# Authentication — MUST be replaced with long random values in production
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev-access-secret-change-me-now
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-now
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
# Optional. Only set when the API and client share a parent domain, e.g. .example.com
# COOKIE_DOMAIN=

# Redis (optional). Without it, an in-memory cache fallback is used.
# Upstash example: rediss://default:<password>@<host>:6379
# REDIS_URL=

# Cloudinary (optional, required for admin media uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=learnova-lms

# Stripe (optional, required for real card payments)
# When these are absent, ALLOW_DEMO_PAYMENTS controls the demo checkout flow.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
# Demo checkout is forcibly disabled when NODE_ENV=production.
ALLOW_DEMO_PAYMENTS=true

# SMTP (optional). Without it, OTP codes are logged and returned in the API
# response only in non-production environments.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Learnova <no-reply@learnova.local>

# Seed / create-admin defaults
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@learnova.local
ADMIN_PASSWORD=Admin@12345

# Logging
LOG_LEVEL=info
