<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= subject %></title>
  </head>
  <body style="margin:0;padding:0;background-color:#f4f5fb;font-family:'Segoe UI',Helvetica,Arial,sans-serif;color:#1e293b;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f5fb;padding:32px 16px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background-color:#ffffff;border-radius:16px;overflow:hidden;box-shadow:0 12px 30px rgba(15,23,42,0.08);">
            <tr>
              <td style="background:linear-gradient(135deg,#4f46e5,#7c3aed);padding:28px 32px;">
                <div style="font-size:20px;font-weight:700;color:#ffffff;letter-spacing:-0.02em;"><%= appName %></div>
                <div style="font-size:13px;color:#e0e7ff;margin-top:4px;">Learn. Build. Ship.</div>
              </td>
            </tr>
            <tr>
              <td style="padding:36px 32px 28px;">
                <h1 style="margin:0 0 12px;font-size:22px;line-height:1.3;color:#0f172a;"><%= heading %></h1>
                <p style="margin:0 0 24px;font-size:15px;line-height:1.65;color:#475569;"><%= message %></p>
                <div style="text-align:center;background:#f8fafc;border:1px dashed #c7d2fe;border-radius:12px;padding:24px;margin:0 0 24px;">
                  <div style="font-size:12px;letter-spacing:0.15em;text-transform:uppercase;color:#64748b;margin-bottom:10px;">Your verification code</div>
                  <div style="font-size:34px;letter-spacing:0.35em;font-weight:700;color:#4338ca;"><%= code %></div>
                  <div style="font-size:12px;color:#94a3b8;margin-top:10px;">This code expires in 10 minutes.</div>
                </div>
                <p style="margin:0 0 8px;font-size:13px;line-height:1.6;color:#64748b;">
                  If you did not request this code, you can safely ignore this email. Never share your code with anyone.
                </p>
              </td>
            </tr>
            <tr>
              <td style="padding:20px 32px 28px;border-top:1px solid #e2e8f0;">
                <p style="margin:0;font-size:12px;line-height:1.6;color:#94a3b8;text-align:center;">
                  © <%= year %> <%= appName %>. All rights reserved.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
